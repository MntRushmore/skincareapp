# Backend origin, no trailing slash. Required.
# Expo Go on a phone cannot use localhost; use your computer's LAN IP
# (or 10.0.2.2 from the Android emulator).
# EXPO_PUBLIC_* values are inlined at bundle time. Set them before
# `npx expo start` and again in EAS for store builds.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional. The app talks to /api/upload on the backend. Set the Uploadcare
# keys on the server (apps/web/.env.example). This public key is only needed
# if you later upload straight from the device.
# EXPO_PUBLIC_UPLOADCARE_PUBLIC_KEY=

# RevenueCat public SDK keys. Leave unset to skip in-app purchases.
# The server still gates scans with Stripe / the RevenueCat webhook.
# EXPO_PUBLIC_REVENUE_CAT_TEST_STORE_API_KEY=
# EXPO_PUBLIC_REVENUE_CAT_APP_STORE_API_KEY=
# EXPO_PUBLIC_REVENUE_CAT_PLAY_STORE_API_KEY=

# Only used by the unused maps polyfill.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
