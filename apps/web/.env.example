# Neon (or any Postgres) connection string. Required for accounts, scans, and subscriptions.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of this web server. http://localhost:4000 locally; https:// in production.
# Cookie secure-flag follows this value.
AUTH_URL=http://localhost:4000

# Google AI Studio key for Gemini 2.5 Flash. Required for /api/analyze-skin.
GEMINI_API_KEY=

# Optional override. Leave unset to call Google's API.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_BASE_URL=

# SerpAPI key for Google Shopping product results. If empty, analysis still
# succeeds and product lists are empty.
SERPAPI_KEY=
# serpapi (default) or none
PRODUCT_SEARCH_PROVIDER=serpapi
# SERPAPI_ENGINE=google_shopping

# Stripe secret key (sk_test_... or sk_live_...). Required for checkout and
# for refreshing subscription status from Stripe.
STRIPE_SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
# Leave empty to allow any origin (Authorization header, not cookies).
# CORS_ORIGINS=http://localhost:8081,http://localhost:4000

# Uploadcare. Optional. Without these, uploads are returned as data URLs
# (or the original URL) and can be stored in Postgres.
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

# RevenueCat webhook Authorization header value, exactly as configured in the
# RevenueCat dashboard (or the raw secret; "Bearer <secret>" is also accepted).
# Required only if you sell subscriptions with RevenueCat / the app stores.
REVENUECAT_WEBHOOK_AUTHORIZATION=

# `npm run dev` listens on 0.0.0.0:4000 (vite.config.ts).
# `npm start` listens on 0.0.0.0 and PORT (default 3000).
# PORT=3000
